# Choose backend: openrouter or ollama (local)
LLM_BACKEND=ollama

# OpenRouter settings (used only when LLM_BACKEND=openrouter)
OPENROUTER_API_KEY=

# Requested model. Keep the :free suffix to avoid paid routes.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Ollama settings (used only when LLM_BACKEND=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Hard guards to reduce free-tier overuse.
MAX_REQUESTS_PER_MINUTE=2
MIN_SECONDS_BETWEEN_REQUESTS=30.0
MAX_TOTAL_REQUESTS_PER_RUN=400
MAX_TOTAL_TOKENS_PER_RUN=200000
REQUEST_TIMEOUT_SECONDS=30

# Simulation controls
GRID_SIZE=30
INITIAL_AGENTS=2
INITIAL_ENERGY=120
MAX_STEPS=60
MAX_POPULATION=60
ENERGY_SPAWN_PROBABILITY=0.03
SEED=42
SCENARIO=baseline
